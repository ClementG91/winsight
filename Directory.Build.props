<Project>
  <!-- Shared build settings for every WinSight project. User-mode components target
       the .NET 10 LTS Windows contract; the kernel driver lives outside this graph. -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <InvariantGlobalization>true</InvariantGlobalization>
    <Version>0.12.1</Version>
    <Deterministic>true</Deterministic>
    <!-- Product identity, set centrally rather than derived from each assembly's name.
         Without this every binary reported ProductName/CompanyName as "winsight-dashboard" with no
         copyright at all: the name Windows put in front of the user in the UAC and SmartScreen
         prompts was a build artifact's filename. It is also what a signing policy pins to decide
         whether a binary presented for signature is the product it claims to be, so it has to be
         deliberate. See docs/CODE_SIGNING.md. -->
    <Product>WinSight</Product>
    <Company>eDeveloppe</Company>
    <Authors>Clément Genest</Authors>
    <Copyright>Copyright © 2026 Clément Genest</Copyright>
    <PackageProjectUrl>https://github.com/ClementG91/winsight</PackageProjectUrl>
    <RepositoryUrl>https://github.com/ClementG91/winsight</RepositoryUrl>
    <PackageLicenseExpression>GPL-3.0-or-later</PackageLicenseExpression>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>
</Project>
