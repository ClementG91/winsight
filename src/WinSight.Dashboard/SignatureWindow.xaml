<Window x:Class="WinSight.Dashboard.SignatureWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:WinSight.Dashboard"
        Title="{Binding [SignatureWindowTitle], Source={x:Static local:LocalizationManager.Instance}}"
        Icon="Assets/winsight-logo.png" Width="640" SizeToContent="Height"
        MinWidth="560" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" Background="#F8FAFC">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="{Binding [SignatureHeading], Source={x:Static local:LocalizationManager.Instance}}"
                   FontSize="20" FontWeight="SemiBold" Foreground="#0F172A" TextWrapping="Wrap" />

        <Border Grid.Row="1" Margin="0,14,0,0" Padding="12,10" CornerRadius="8"
                Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Text="{Binding [SignatureFileLabel], Source={x:Static local:LocalizationManager.Instance}}"
                           FontWeight="SemiBold" Foreground="#475569" />
                <TextBlock x:Name="FileText" Grid.Column="2" TextWrapping="Wrap" Foreground="#0F172A" />
                <TextBlock Grid.Row="1" Margin="0,6,0,0"
                           Text="{Binding [SignatureStateLabel], Source={x:Static local:LocalizationManager.Instance}}"
                           FontWeight="SemiBold" Foreground="#475569" />
                <TextBlock x:Name="StateText" Grid.Row="1" Grid.Column="2" Margin="0,6,0,0"
                           TextWrapping="Wrap" FontWeight="SemiBold" Foreground="#0F172A" />
                <TextBlock Grid.Row="2" Margin="0,6,0,0"
                           Text="{Binding [SignatureSignerLabel], Source={x:Static local:LocalizationManager.Instance}}"
                           FontWeight="SemiBold" Foreground="#475569" />
                <TextBlock x:Name="SignerText" Grid.Row="2" Grid.Column="2" Margin="0,6,0,0"
                           TextWrapping="Wrap" Foreground="#0F172A" />
            </Grid>
        </Border>

        <Border x:Name="NotePanel" Grid.Row="2" Margin="0,12,0,0" Padding="12,9" CornerRadius="8"
                Background="#FFF7ED" BorderBrush="#FED7AA" BorderThickness="1" Visibility="Collapsed">
            <TextBlock x:Name="NoteText" Foreground="#9A3412" FontWeight="SemiBold" TextWrapping="Wrap" />
        </Border>

        <!-- Read-only text boxes rather than labels, so a hash can be selected and copied for a lookup. -->
        <StackPanel x:Name="HashesPanel" Grid.Row="3" Margin="0,14,0,0" Visibility="Collapsed">
            <TextBlock Text="{Binding [SignatureHashesLabel], Source={x:Static local:LocalizationManager.Instance}}"
                       FontWeight="SemiBold" Foreground="#475569" />
            <Grid Margin="0,6,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="70" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Text="MD5" VerticalAlignment="Center" Foreground="#64748B" />
                <TextBox x:Name="Md5Box" Grid.Column="1" IsReadOnly="True" FontFamily="Consolas" />
                <TextBlock Grid.Row="1" Margin="0,4,0,0" Text="SHA-1" VerticalAlignment="Center" Foreground="#64748B" />
                <TextBox x:Name="Sha1Box" Grid.Row="1" Grid.Column="1" Margin="0,4,0,0"
                         IsReadOnly="True" FontFamily="Consolas" />
                <TextBlock Grid.Row="2" Margin="0,4,0,0" Text="SHA-256" VerticalAlignment="Center" Foreground="#64748B" />
                <TextBox x:Name="Sha256Box" Grid.Row="2" Grid.Column="1" Margin="0,4,0,0"
                         IsReadOnly="True" FontFamily="Consolas" />
            </Grid>
        </StackPanel>

        <Button x:Name="CloseButton" Grid.Row="4" Margin="0,20,0,0" MinWidth="120" HorizontalAlignment="Right"
                Content="{Binding [Close], Source={x:Static local:LocalizationManager.Instance}}"
                IsDefault="True" IsCancel="True" Click="CloseButton_Click" />
    </Grid>
</Window>
