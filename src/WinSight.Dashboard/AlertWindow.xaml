<Window x:Class="WinSight.Dashboard.AlertWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:WinSight.Dashboard"
        Title="{Binding [AlertWindowTitle], Source={x:Static local:LocalizationManager.Instance}}"
        Icon="Assets/winsight-logo.png" Width="560" SizeToContent="Height"
        MinWidth="520" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" Background="#F8FAFC"
        Topmost="True" ShowInTaskbar="True">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="{Binding [AlertHeading], Source={x:Static local:LocalizationManager.Instance}}"
                   FontSize="20" FontWeight="SemiBold" Foreground="#0F172A" TextWrapping="Wrap" />

        <Border Grid.Row="1" Margin="0,14,0,0" Padding="12,10" CornerRadius="8"
                Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Text="{Binding [AlertItemLabel], Source={x:Static local:LocalizationManager.Instance}}"
                           FontWeight="SemiBold" Foreground="#475569" />
                <TextBlock x:Name="ItemText" Grid.Column="2" TextWrapping="Wrap" Foreground="#0F172A" />
                <TextBlock Grid.Row="1" Margin="0,6,0,0"
                           Text="{Binding [AlertLocationLabel], Source={x:Static local:LocalizationManager.Instance}}"
                           FontWeight="SemiBold" Foreground="#475569" />
                <TextBlock x:Name="LocationText" Grid.Row="1" Grid.Column="2" Margin="0,6,0,0"
                           TextWrapping="Wrap" Foreground="#0F172A" />
                <TextBlock Grid.Row="2" Margin="0,6,0,0"
                           Text="{Binding [AlertProgramLabel], Source={x:Static local:LocalizationManager.Instance}}"
                           FontWeight="SemiBold" Foreground="#475569" />
                <TextBlock x:Name="ProgramText" Grid.Row="2" Grid.Column="2" Margin="0,6,0,0"
                           TextWrapping="Wrap" Foreground="#0F172A" />
            </Grid>
        </Border>

        <TextBlock x:Name="HintText" Grid.Row="2" Margin="0,12,0,0" TextWrapping="Wrap" Foreground="#64748B" />

        <Border x:Name="StatusPanel" Grid.Row="3" Margin="0,12,0,0" Padding="12,9" CornerRadius="8"
                Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" Visibility="Collapsed">
            <TextBlock x:Name="StatusText" Foreground="#1E3A8A" FontWeight="SemiBold" TextWrapping="Wrap" />
        </Border>

        <!--
            No destructive default: "Decide later" is the cancel/default action, so a stray Enter or
            Escape never removes a startup item. Block is deliberately not IsDefault.
        -->
        <Grid Grid.Row="4" Margin="0,20,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button x:Name="LaterButton"
                    Content="{Binding [AlertDecideLater], Source={x:Static local:LocalizationManager.Instance}}"
                    IsCancel="True" IsDefault="True" Click="LaterButton_Click" />
            <Button x:Name="AllowButton" Grid.Column="2"
                    Content="{Binding [AlertAllow], Source={x:Static local:LocalizationManager.Instance}}"
                    Click="AllowButton_Click" />
            <Button x:Name="BlockButton" Grid.Column="4"
                    Content="{Binding [AlertBlock], Source={x:Static local:LocalizationManager.Instance}}"
                    Click="BlockButton_Click" />
        </Grid>
    </Grid>
</Window>
