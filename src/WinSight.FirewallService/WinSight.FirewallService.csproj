<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>WinSight.FirewallService</RootNamespace>
    <AssemblyName>winsight-firewall-service</AssemblyName>
    <!-- This one runs as SYSTEM. Anyone auditing what is privileged on their machine reads this
         string in Task Manager and in the service list; it must say what it is. -->
    <AssemblyTitle>WinSight Outbound Firewall Service</AssemblyTitle>
    <!-- The LibraryImport source generator emits unsafe marshalling stubs. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <!-- Lets tests await the policy-snapshot reload directly instead of depending on the timing of
         the background refresh, which is the whole point of that refresh being off the trace thread. -->
    <InternalsVisibleTo Include="WinSight.FirewallService.Tests" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\WinSight.Firewall\WinSight.Firewall.csproj" />
    <!-- The ETW outbound watcher lives with the other live network watchers. -->
    <ProjectReference Include="..\WinSight.NetMonitor\WinSight.NetMonitor.csproj" />
  </ItemGroup>
</Project>
